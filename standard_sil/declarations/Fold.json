{
  "id": "Silfold",
  "axis": "node",
  "domain": "app",
  "authoritative": false,
  "refines": "ReductionCombinator",
  "path": "node/capability/silfold",
  "description": "Accumulates a multiplicity into one result by an open combining morphism port, starting from a seed.",
