  {
    "id": "ProposeAlfworldPlacement",
    "path": "node/capability/proposealfworldplacement",
    "axis": "node",
    "domain": "app",
    "authoritative": false,
    "refines": "Capability",
    "description": "Proposes movement of one ALFWorld object between receptacle contents and actor inventory through the explicitly supplied HG bindings. Both holders must have one shared admitted room context. The object has one current placement, which is replaced without changing its identity.",
    "guarantees": [
      "Previous and next holders must be distinct, with exactly one actor and one receptacle.",
      "The object must have exactly one current HAS_PART placement from the previous holder under the supplied binding.",
      "Both holders must have one evidenced location referring to the same AlfworldRoom.",
      "Preserves every subject and all relationships except the exact placement being replaced.",
      "The typed result preserves the original ingress and cannot authorise its own materialisation."
    ],
    "input_ports": [
