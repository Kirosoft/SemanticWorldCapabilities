  "groups": [
    "standard-sil"
  ],
  "relationship_bindings": [],
  "inputs": [
    {
      "type": "node/capability",
      "cardinality": {
        "min": 1,
        "max": 1
      },
      "bridge": {
        "inputs": [
          "?B",
          "?A"
        ],
        "outputs": [
          "?B"
        ]
      }
    },
    {
      "type": "node/document",
      "cardinality": {
        "min": 1,
        "max": 1
      },
      "carries": "?B"
    },
    {
      "type": "node/projection",
      "cardinality": {
        "min": 1,
        "max": 1
      },
      "carries": "?A"
    }
  ],
  "outputs": [
    {
      "type": "node/document",
      "cardinality": {
        "min": 1,
        "max": 1
      },
      "carries": "?B"
    }
  ]
}
